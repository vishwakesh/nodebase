# Copy these into your Coolify application's environment variables. Never commit real values.
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
TRUST_PROXY=true

# First-run admin creation key. Use: openssl rand -hex 24
NODEBASE_SETUP_KEY=replace-with-a-long-random-one-time-setup-key
# Required AES-256-GCM key. Generate using: openssl rand -base64 32
NODEBASE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Persistent storage inside both the panel and runner containers.
NODEBASE_STORAGE_ROOT=/srv/nodebase/data
NODEBASE_DATABASE_PATH=/srv/nodebase/data/db/nodebase.sqlite
NODEBASE_BOT_ROOT=/srv/nodebase/data/bots
NODEBASE_BLOB_ROOT=/srv/nodebase/data/file-blobs
NODEBASE_BACKUP_ROOT=/srv/nodebase/data/backups
# Host-side path mounted at /srv/nodebase/data in both services.
NODEBASE_HOST_DATA_ROOT=/srv/nodebase/data
NODEBASE_MAX_FILE_BYTES=1073741824
NODEBASE_MAX_STORAGE_BYTES=107374182400
NODEBASE_MAX_BOT_ZIP_BYTES=262144000
NODEBASE_SESSION_DAYS=7

# Must match on panel and runner; generate using: openssl rand -hex 32
RUNNER_TOKEN=replace-with-a-long-random-runner-token
RUNNER_URL=http://runner:3099
RUNNER_HOST=0.0.0.0
RUNNER_PORT=3099
WORKSPACE_ROOT=/srv/nodebase/data/bots
DOCKER_SOCKET=/var/run/docker.sock
# Determine the docker socket group ID with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
BOT_MEMORY_MB=512
BOT_CPU_NANOS=500000000

# Set to the exact browser origin for your NODEBASE panel, with no trailing slash.
# Example: https://nodebase.example.com
FRONTEND_ORIGIN=https://YOUR_NODEBASE_DOMAIN
LOG_LEVEL=info
