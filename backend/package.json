{
  "name": "@nodebase/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "NODE_ENV=test NODEBASE_DISABLE_LISTEN=1 NODEBASE_SETUP_KEY=nodebase-test-setup-key NODEBASE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= NODEBASE_STORAGE_ROOT=/tmp/nodebase-test-storage NODEBASE_DATABASE_PATH=/tmp/nodebase-test-storage/db/nodebase.sqlite NODEBASE_STATIC_DIR=/tmp/nodebase-no-static tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.1",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "mime-types": "^2.1.35",
    "yauzl": "^3.2.0",
    "zod": "^3.24.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.10",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
